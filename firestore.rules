rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Queue entries: anyone with the link can create/read/update.
    // This is intentionally open (no login system for a walk-up event),
    // but scoped tightly to just these two collections.
    match /queue/{ticketId} {
      allow read, write: if true;
    }

    match /meta/{docId} {
      allow read, write: if true;
    }

    // Everything else is locked down by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
